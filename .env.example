# Copie para .env no servidor e preencha os valores.
# Nunca publique .env nem credenciais da sessão.
BOT_NAME=Chegô Delivery
# Números autorizados como administradores, com código do país, sem +, separados por vírgula.
ADMIN_NUMBERS=
# Nomes exatos dos quatro grupos permitidos, separados por |||
AUTHORIZED_GROUP_NAMES=SEU DELIVERY | EQUIPE MOTOBOY|||SEU DELIVERY | SEU DELIVERY PATOS-PB|||CHEGÔ DELIVERY | CHEGÔ ENTREGADORES🚀|||CHEGÔ DELIVERY | CHEGÔ DELIVERY (EMPRESAS)
# false tenta autenticar por código de pareamento no primeiro início (não exibe QR).
USE_PAIRING_CODE=true
# Obrigatório para gerar código de pareamento, com código do país e DDD, sem +, espaços ou traços.
WHATSAPP_PHONE_NUMBER=
# Diretório de dados persistentes. Não versionar.
DATA_DIR=./data
TIMEZONE=America/Fortaleza
